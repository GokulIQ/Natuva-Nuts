/* ==========================================================================
   NATUVA GOURMET — LUXURY DRY FRUITS & NUTS STORE
   Modern Multipurpose HTML Website Template
   Author: Senior Frontend Architect & Design Director
   Version: 1.0.0
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. DESIGN TOKENS & CSS CUSTOM PROPERTIES
   -------------------------------------------------------------------------- */
:root {
  /* Brand Primary & Greens */
  --color-primary: #183329;
  --color-primary-light: #25483B;
  --color-primary-dark: #0F221B;
  --color-primary-rgb: 24, 51, 41;

  --color-pistachio: #5E8C6A;
  --color-pistachio-light: #EDF4EE;
  --color-pistachio-dark: #43694D;
  --color-pistachio-rgb: 94, 140, 106;

  /* Gourmet Warm Accents (Almonds, Roasted, Honey, Gold) */
  --color-almond: #87532E;
  --color-almond-light: #F7EFE9;
  --color-cinnamon: #BA6C39;
  --color-gold: #C29B48;
  --color-gold-light: #EBDCB7;
  --color-gold-dark: #9E7928;
  --color-gold-rgb: 194, 155, 72;

  /* Surfaces & Backgrounds - Light Theme */
  --bg-body: #FAF7F2;
  --bg-surface: #FFFFFF;
  --bg-surface-alt: #F3ECE1;
  --bg-surface-tint: #F7F3EA;
  --bg-header: rgba(250, 247, 242, 0.94);
  --bg-card: #FFFFFF;
  --bg-card-hover: #FFFFFF;
  --bg-footer: #11231C;
  --bg-modal: #FFFFFF;
  --bg-drawer: #FFFFFF;

  /* Typography Colors - Light Theme */
  --text-main: #1A2722;
  --text-heading: #12241D;
  --text-muted: #5F6E67;
  --text-subtle: #87958F;
  --text-inverse: #FAF7F2;
  --text-gold: #C29B48;

  /* Borders & Dividers */
  --border-light: #E7DFD4;
  --border-medium: #D5C9B8;
  --border-focus: #5E8C6A;
  --border-gold: rgba(194, 155, 72, 0.4);

  /* Shadows */
  --shadow-xs: 0 1px 3px rgba(18, 36, 29, 0.05);
  --shadow-sm: 0 4px 12px rgba(18, 36, 29, 0.06);
  --shadow-md: 0 8px 24px rgba(18, 36, 29, 0.08);
  --shadow-lg: 0 16px 36px rgba(18, 36, 29, 0.12);
  --shadow-xl: 0 24px 48px rgba(18, 36, 29, 0.16);
  --shadow-gold: 0 10px 25px rgba(194, 155, 72, 0.22);

  /* Typography Scale */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --font-accent: 'Cormorant Garamond', Georgia, serif;

  /* Layout, Radius & Transitions */
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --radius-full: 9999px;

  --transition-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 0.42s cubic-bezier(0.2, 0.8, 0.2, 1);

  --header-height: 84px;
  --topbar-height: 40px;
}

/* --------------------------------------------------------------------------
   DARK THEME VARIABLES
   -------------------------------------------------------------------------- */
[data-bs-theme="dark"] {
  --color-primary: #1D3A2F;
  --color-primary-light: #2A5143;
  --color-primary-dark: #12241D;
  --color-primary-rgb: 29, 58, 47;

  --color-pistachio: #7CA888;
  --color-pistachio-light: #1A3023;
  --color-pistachio-dark: #98BF9F;

  --color-almond: #BC7B4C;
  --color-almond-light: #2A1D15;
  --color-cinnamon: #D48855;
  --color-gold: #D8B772;
  --color-gold-light: #322A17;
  --color-gold-dark: #F0D495;

  /* Surfaces & Backgrounds - Dark Theme */
  --bg-body: #0C1613;
  --bg-surface: #14221D;
  --bg-surface-alt: #192B25;
  --bg-surface-tint: #162621;
  --bg-header: rgba(12, 22, 19, 0.94);
  --bg-card: #15241F;
  --bg-card-hover: #192B25;
  --bg-footer: #08100E;
  --bg-modal: #15241F;
  --bg-drawer: #14221D;

  /* Typography Colors - Dark Theme */
  --text-main: #ECE7DE;
  --text-heading: #F8F5EE;
  --text-muted: #9EAEA5;
  --text-subtle: #7A8B83;
  --text-inverse: #0C1613;
  --text-gold: #D8B772;

  /* Borders & Dividers */
  --border-light: #23372F;
  --border-medium: #2F473D;
  --border-focus: #7CA888;
  --border-gold: rgba(216, 183, 114, 0.35);

  /* Shadows */
  --shadow-xs: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.35);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 16px 36px rgba(0, 0, 0, 0.55);
  --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.65);
  --shadow-gold: 0 10px 25px rgba(216, 183, 114, 0.15);
}

/* --------------------------------------------------------------------------
   2. RESET & BASE ELEMENTS
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-body);
  color: var(--text-main);
  line-height: 1.68;
  font-weight: 400;
  overflow-x: clip;
  transition: background-color var(--transition-normal), color var(--transition-normal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
  font-family: var(--font-serif);
  color: var(--text-heading);
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: -0.015em;
  margin-bottom: 0.8rem;
}

h1, .h1 { font-size: clamp(2.2rem, 4.5vw, 3.8rem); font-weight: 700; }
h2, .h2 { font-size: clamp(1.85rem, 3.2vw, 2.75rem); font-weight: 700; }
h3, .h3 { font-size: clamp(1.4rem, 2.2vw, 1.95rem); font-weight: 600; }
h4, .h4 { font-size: clamp(1.15rem, 1.6vw, 1.45rem); font-weight: 600; }
h5, .h5 { font-size: 1.15rem; font-weight: 600; }
h6, .h6 { font-size: 0.95rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }

p {
  margin-bottom: 1.25rem;
}

p.lead {
  font-size: 1.15rem;
  font-weight: 400;
  line-height: 1.7;
  color: var(--text-muted);
}

a {
  color: var(--color-pistachio-dark);
  text-decoration: none;
  transition: color var(--transition-fast), border-color var(--transition-fast);
}

a:hover, a:focus-visible {
  color: var(--color-gold);
}

img, svg {
  vertical-align: middle;
  max-width: 100%;
  height: auto;
}

ul, ol {
  padding-left: 1.25rem;
}

/* --------------------------------------------------------------------------
   3. UTILITY CLASSES & BADGES
   -------------------------------------------------------------------------- */
.font-serif { font-family: var(--font-serif) !important; }
.font-sans { font-family: var(--font-sans) !important; }
.font-accent { font-family: var(--font-accent) !important; }

.bg-body-main { background-color: var(--bg-body) !important; }
.bg-surface-card { background-color: var(--bg-card) !important; }
.bg-surface-tinted { background-color: var(--bg-surface-tint) !important; }
.bg-surface-secondary { background-color: var(--bg-surface-alt) !important; }
.bg-brand-primary { background-color: var(--color-primary) !important; }
.bg-brand-dark { background-color: var(--bg-footer) !important; }

.text-heading-color { color: var(--text-heading) !important; }
.text-body-color { color: var(--text-main) !important; }
.text-muted-color { color: var(--text-muted) !important; }
.text-gold { color: var(--color-gold) !important; }
.text-pistachio { color: var(--color-pistachio) !important; }
.text-almond { color: var(--color-almond) !important; }

.border-theme { border: 1px solid var(--border-light) !important; }
.border-theme-gold { border: 1px solid var(--border-gold) !important; }

/* Subtitle Kicker Pill */
.section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.95rem;
  border-radius: var(--radius-full);
  background-color: var(--color-pistachio-light);
  color: var(--color-primary);
  font-size: 0.825rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.9rem;
  border: 1px solid rgba(94, 140, 106, 0.2);
}

.section-kicker.kicker-gold {
  background-color: var(--color-gold-light);
  color: var(--color-almond);
  border-color: rgba(194, 155, 72, 0.3);
}

[data-bs-theme="dark"] .section-kicker {
  background-color: rgba(124, 168, 136, 0.15);
  color: #B1D4BA;
  border-color: rgba(124, 168, 136, 0.3);
}

[data-bs-theme="dark"] .section-kicker.kicker-gold {
  background-color: rgba(216, 183, 114, 0.15);
  color: #E6CE99;
  border-color: rgba(216, 183, 114, 0.3);
}

/* Section Header Structure */
.section-header {
  margin-bottom: 3rem;
}

.section-header .section-subtitle {
  max-width: 640px;
  color: var(--text-muted);
  font-size: 1.05rem;
  margin-left: auto;
  margin-right: auto;
}

.section-padding {
  padding-top: clamp(3.5rem, 6vw, 6rem);
  padding-bottom: clamp(3.5rem, 6vw, 6rem);
}

.section-padding-sm {
  padding-top: clamp(2.5rem, 4vw, 4rem);
  padding-bottom: clamp(2.5rem, 4vw, 4rem);
}

/* --------------------------------------------------------------------------
   4. BUTTONS & INTERACTIVE CONTROLS
   -------------------------------------------------------------------------- */
.btn {
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 0.925rem;
  padding: 0.72rem 1.65rem;
  border-radius: var(--radius-full);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  transition: all var(--transition-fast);
  letter-spacing: 0.015em;
  border: 1px solid transparent;
}

.btn:focus-visible {
  outline: 2px solid var(--border-focus);
  outline-offset: 3px;
}

/* Primary Forest Green */
.btn-primary-custom {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
  box-shadow: 0 4px 14px rgba(24, 51, 41, 0.18);
}

.btn-primary-custom:hover {
  background-color: var(--color-primary-light);
  color: #FFFFFF;
  border-color: var(--color-primary-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(24, 51, 41, 0.25);
}

/* Luxury Gold Button */
.btn-gold {
  background-color: var(--color-gold);
  color: #12241D;
  border-color: var(--color-gold);
  box-shadow: 0 4px 15px rgba(194, 155, 72, 0.28);
}

.btn-gold:hover {
  background-color: #D4AF57;
  color: #0A1612;
  border-color: #D4AF57;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(194, 155, 72, 0.38);
}

/* Outline Buttons */
.btn-outline-custom {
  background-color: transparent;
  color: var(--text-heading);
  border-color: var(--border-medium);
}

.btn-outline-custom:hover {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
  transform: translateY(-2px);
}

.btn-outline-gold {
  background-color: transparent;
  color: var(--color-gold);
  border-color: var(--color-gold);
}

.btn-outline-gold:hover {
  background-color: var(--color-gold);
  color: #12241D;
  transform: translateY(-2px);
}

.btn-icon-square {
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: var(--radius-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-icon-circle {
  width: 42px;
  height: 42px;
  padding: 0;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* --------------------------------------------------------------------------
   5. TOPBAR & MAIN NAVIGATION
   -------------------------------------------------------------------------- */
.topbar {
  background-color: var(--color-primary-dark);
  color: rgba(255, 255, 255, 0.85);
  font-size: 0.825rem;
  padding: 0.45rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  position: relative;
  z-index: 1030;
}

.topbar a {
  color: rgba(255, 255, 255, 0.85);
}

.topbar a:hover {
  color: var(--color-gold-light);
}

.topbar-badge {
  background-color: rgba(194, 155, 72, 0.25);
  color: var(--color-gold-light);
  padding: 0.15rem 0.55rem;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  margin-right: 0.5rem;
}

.site-header {
  position: sticky;
  top: 0;
  width: 100%;
  background-color: var(--bg-header);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-light);
  z-index: 1020;
  transition: box-shadow var(--transition-normal), background-color var(--transition-normal);
}

.site-header.is-scrolled {
  box-shadow: var(--shadow-sm);
}

.site-header > .container {
  width: 100%;
  max-width: 1600px;
  padding-inline: clamp(16px, 2.5vw, 40px);
}

.site-header .navbar {
  min-height: 80px;
  column-gap: 1rem;
}

.site-header .navbar-collapse {
  min-width: 0;
  gap: 1rem;
}

.site-header .navbar-nav {
  align-items: center;
}

.site-header .navbar-nav .nav-link {
  white-space: nowrap;
  padding: 0.65rem clamp(0.4rem, 0.7vw, 0.75rem) !important;
}

.site-header .navbar-toggler {
  width: 44px;
  height: 44px;
  padding: 0;
  flex-shrink: 0;
}

.navbar-brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
  margin: 0;
}

.brand-symbol {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-pistachio-dark));
  color: var(--color-gold-light);
  border-radius: 12px;
  font-size: 1.35rem;
  box-shadow: 0 4px 10px rgba(24, 51, 41, 0.2);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text-heading);
  line-height: 1;
}

.brand-tagline {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--color-gold);
  font-weight: 600;
  margin-top: 3px;
}

/* Nav Links */
.navbar-nav .nav-link {
  font-family: var(--font-sans);
  font-size: 0.935rem;
  font-weight: 500;
  color: var(--text-main);
  padding: 0.65rem 1rem !important;
  position: relative;
  transition: color var(--transition-fast);
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link:focus,
.navbar-nav .nav-link.active {
  color: var(--color-pistachio-dark);
}

[data-bs-theme="dark"] .navbar-nav .nav-link:hover,
[data-bs-theme="dark"] .navbar-nav .nav-link.active {
  color: var(--color-gold);
}

/* Dropdown Menu */
.navbar-nav .dropdown-menu {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  padding: 0.65rem;
  min-width: 220px;
  margin-top: 0.5rem;
  animation: fadeInMenu 0.2s ease-out;
}

@keyframes fadeInMenu {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.dropdown-item {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-main);
  padding: 0.6rem 0.95rem;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  transition: all var(--transition-fast);
}

.dropdown-item:hover, .dropdown-item:focus {
  background-color: var(--bg-surface-tint);
  color: var(--color-primary);
  transform: translateX(3px);
}

[data-bs-theme="dark"] .dropdown-item:hover {
  background-color: var(--bg-surface-alt);
  color: var(--color-gold);
}

/* Header Action Icons */
.header-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.header-action-btn {
  background: var(--bg-surface-tint);
  border: 1px solid var(--border-light);
  color: var(--text-main);
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  padding: 0;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.05rem;
  line-height: 1;
  position: relative;
  transition: all var(--transition-fast);
}

.header-action-btn:hover {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

.header-action-btn.rtl-toggle-btn {
  font-size: 0.75rem;
  font-weight: 600;
}

.header-action-btn.header-shop-btn {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: #FFFFFF;
}

.header-action-btn:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 3px;
}

.cart-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background-color: var(--color-almond);
  color: #FFFFFF;
  font-size: 0.7rem;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

/* --------------------------------------------------------------------------
   6. HERO SECTIONS (HOME 1 & HOME 2 DISTINCT DESIGNS)
   -------------------------------------------------------------------------- */
/* Home 1 Hero: Modern Organic Editorial Layered Hero */
.hero-home-1 {
  background: radial-gradient(circle at 80% 20%, rgba(94, 140, 106, 0.12) 0%, transparent 60%),
              radial-gradient(circle at 10% 80%, rgba(194, 155, 72, 0.1) 0%, transparent 50%),
              var(--bg-body);
  padding: clamp(3rem, 6vw, 6.5rem) 0 clamp(3.5rem, 7vw, 7rem);
  position: relative;
  overflow: hidden;
}

.hero-home-1::before {
  content: "";
  position: absolute;
  top: -150px;
  right: -100px;
  width: 450px;
  height: 450px;
  background: radial-gradient(circle, rgba(194, 155, 72, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-title-large {
  font-size: clamp(2.4rem, 5.2vw, 4.2rem);
  font-weight: 700;
  line-height: 1.15;
  color: var(--text-heading);
  margin-bottom: 1.4rem;
}

.hero-title-large .highlight {
  color: var(--color-pistachio-dark);
  font-style: italic;
  font-weight: 600;
  position: relative;
  display: inline-block;
}

[data-bs-theme="dark"] .hero-title-large .highlight {
  color: var(--color-gold);
}

.hero-stats-row {
  display: flex;
  align-items: center;
  gap: 2.2rem;
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-light);
}

.hero-stat-item h4 {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 0.15rem;
}

[data-bs-theme="dark"] .hero-stat-item h4 {
  color: var(--color-gold);
}

.hero-stat-item p {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 500;
}

.hero-visual-card {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--border-light);
}

.hero-visual-card img {
  width: 100%;
  height: clamp(380px, 48vw, 540px);
  object-fit: cover;
  transition: transform 0.8s ease;
}

.hero-visual-card:hover img {
  transform: scale(1.03);
}

.hero-floating-badge {
  position: absolute;
  bottom: 24px;
  left: 24px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 0.9rem 1.4rem;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

[data-bs-theme="dark"] .hero-floating-badge {
  background: rgba(21, 36, 31, 0.92);
  border-color: rgba(124, 168, 136, 0.25);
}

.hero-floating-badge-icon {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background-color: var(--color-gold-light);
  color: var(--color-almond);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}

/* Home 2 Hero: Editorial Split Luxury Gifting Concept */
.hero-home-2 {
  background-color: var(--bg-surface-tint);
  padding: clamp(3.5rem, 6.5vw, 6.5rem) 0;
  position: relative;
  border-bottom: 1px solid var(--border-light);
}

.hero-split-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
}

@media (max-width: 991px) {
  .hero-split-grid {
    grid-template-columns: 1fr;
  }
}

.hero-curated-gallery {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 1.2rem;
  position: relative;
}

.hero-curated-img-main {
  height: 460px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.hero-curated-img-secondary {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.hero-curated-thumb {
  height: 220px;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.hero-curated-img-main img,
.hero-curated-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.hero-curated-img-main:hover img,
.hero-curated-thumb:hover img {
  transform: scale(1.04);
}

/* Page Inner Hero (Products, About, Bulk, Blog, Contact, etc.) */
.page-hero {
  background: linear-gradient(135deg, rgba(24, 51, 41, 0.95), rgba(15, 34, 27, 0.96)),
              var(--color-primary);
  color: #FFFFFF;
  padding: clamp(2.5rem, 4vw, 4rem) 0;
  position: relative;
  overflow: hidden;
}

.page-hero-title {
  color: #FFFFFF;
  font-size: clamp(2.2rem, 4vw, 3.2rem);
  margin-bottom: 0.75rem;
}

/* --------------------------------------------------------------------------
   7. PRODUCT CARDS & GIFT CARDS
   -------------------------------------------------------------------------- */
.product-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 1.15rem;
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
  box-shadow: var(--shadow-xs);
  transition: all var(--transition-normal);
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
  border-color: var(--border-medium);
}

.product-badge-wrap {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.badge-tag {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.28rem 0.65rem;
  border-radius: var(--radius-full);
}

.badge-organic {
  background-color: var(--color-pistachio);
  color: #FFFFFF;
}

.badge-sale {
  background-color: var(--color-cinnamon);
  color: #FFFFFF;
}

.badge-premium {
  background-color: var(--color-gold);
  color: #12241D;
}

.product-thumb-wrap {
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background-color: var(--bg-surface-alt);
  aspect-ratio: 1 / 1;
  margin-bottom: 1.1rem;
}

.product-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-thumb-wrap img {
  transform: scale(1.06);
}

.product-quick-actions {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  opacity: 0;
  display: flex;
  gap: 0.5rem;
  transition: all var(--transition-normal);
  z-index: 4;
}

.product-card:hover .product-quick-actions {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

.product-action-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background-color: #FFFFFF;
  color: var(--text-main);
  border: 1px solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.product-action-btn:hover {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border-color: var(--color-primary);
}

.product-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.45rem;
}

.product-category-label {
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-pistachio-dark);
}

[data-bs-theme="dark"] .product-category-label {
  color: var(--color-gold);
}

.product-weight-label {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 500;
}

.product-card-title {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 0.5rem;
}

.product-card-title a {
  color: var(--text-heading);
}

.product-card-title a:hover {
  color: var(--color-pistachio-dark);
}

.product-rating {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.8rem;
  color: #E89E28;
  margin-bottom: 0.75rem;
}

.product-rating .rating-count {
  color: var(--text-muted);
  font-size: 0.75rem;
  margin-left: 0.3rem;
}

.product-card-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding-top: 0.85rem;
  border-top: 1px solid var(--border-light);
}

.product-price-wrap {
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
  align-items: baseline;
  gap: 0.45rem;
}

.product-card-footer > .btn {
  flex-shrink: 0;
  width: auto;
}

.current-price, .original-price {
  white-space: nowrap;
}

.current-price {
  font-family: var(--font-sans);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--color-primary);
}

[data-bs-theme="dark"] .current-price {
  color: var(--color-gold);
}

.original-price {
  font-size: 0.85rem;
  color: var(--text-subtle);
  text-decoration: line-through;
}

/* Category Feature Card */
.category-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  padding: 1.4rem 1.1rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-xs);
  transition: all var(--transition-normal);
  height: 100%;
}

.category-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
  border-color: var(--color-pistachio);
}

.category-img-wrap {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 1rem;
  border: 2px solid var(--border-light);
  box-shadow: var(--shadow-sm);
  background-color: var(--bg-surface-alt);
}

.category-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.category-card:hover .category-img-wrap img {
  transform: scale(1.12);
}

.category-title {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
  color: var(--text-heading);
}

.category-count {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* --------------------------------------------------------------------------
   8. GIFT BOX CARDS & LUXURY HAMPER CATALOG
   -------------------------------------------------------------------------- */
.gift-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-gold);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
}

.gift-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-gold);
}

.gift-thumb-wrap {
  position: relative;
  aspect-ratio: 16 / 11;
  overflow: hidden;
  background-color: var(--bg-surface-alt);
}

.gift-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.gift-card:hover .gift-thumb-wrap img {
  transform: scale(1.05);
}

.gift-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.gift-occasion-badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-almond);
  margin-bottom: 0.4rem;
}

.gift-card-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 600;
  margin-bottom: 0.6rem;
}

.gift-card-title a {
  color: var(--text-heading);
}

.gift-card-title a:hover {
  color: var(--color-gold);
}

.gift-items-preview {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.55;
  margin-bottom: 1.2rem;
}

/* --------------------------------------------------------------------------
   9. SOURCING STORIES & EDITORIAL CARDS
   -------------------------------------------------------------------------- */
.story-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xs);
  transition: all var(--transition-normal);
}

.story-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
}

.story-thumb-wrap {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
}

.story-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.story-card:hover .story-thumb-wrap img {
  transform: scale(1.05);
}

.story-origin-tag {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(18, 36, 29, 0.85);
  backdrop-filter: blur(6px);
  color: var(--color-gold-light);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.story-card-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.story-card-title {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  line-height: 1.35;
}

.story-card-title a {
  color: var(--text-heading);
}

.story-card-title a:hover {
  color: var(--color-pistachio-dark);
}

/* --------------------------------------------------------------------------
   10. BLOG CARDS & ARTICLE LAYOUT
   -------------------------------------------------------------------------- */
.blog-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md);
  overflow: hidden;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xs);
  transition: all var(--transition-normal);
}

.blog-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
}

.blog-thumb-wrap {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background-color: var(--bg-surface-alt);
}

.blog-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.blog-card:hover .blog-thumb-wrap img {
  transform: scale(1.06);
}

.blog-card-body {
  padding: 1.4rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.blog-meta-bar {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-bottom: 0.65rem;
}

.blog-meta-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.blog-card-title {
  font-family: var(--font-serif);
  font-size: 1.22rem;
  font-weight: 600;
  line-height: 1.38;
  margin-bottom: 0.75rem;
}

.blog-card-title a {
  color: var(--text-heading);
}

.blog-card-title a:hover {
  color: var(--color-pistachio-dark);
}

.blog-excerpt {
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 1.1rem;
}

/* --------------------------------------------------------------------------
   11. TESTIMONIALS & TRUST SECTION
   -------------------------------------------------------------------------- */
.testimonial-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: 2rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xs);
  transition: all var(--transition-normal);
  position: relative;
}

.testimonial-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--border-medium);
}

.testimonial-stars {
  color: #E89E28;
  font-size: 0.9rem;
  margin-bottom: 1rem;
}

.testimonial-quote {
  font-family: var(--font-accent);
  font-size: 1.25rem;
  font-style: italic;
  line-height: 1.5;
  color: var(--text-heading);
  margin-bottom: 1.5rem;
  flex-grow: 1;
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-light);
}

.author-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--color-gold-light);
}

.author-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-heading);
  margin-bottom: 0.1rem;
}

.author-role {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* --------------------------------------------------------------------------
   12. SLIDE-OUT SHOPPING CART DRAWER & MODAL
   -------------------------------------------------------------------------- */
.cart-drawer-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(10, 20, 16, 0.65);
  backdrop-filter: blur(4px);
  z-index: 1060;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.cart-drawer-overlay.is-open {
  opacity: 1;
  visibility: visible;
}

.cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 440px;
  height: 100%;
  background-color: var(--bg-drawer);
  box-shadow: var(--shadow-xl);
  z-index: 1070;
  transform: translateX(100%);
  transition: transform var(--transition-smooth);
  display: flex;
  flex-direction: column;
}

.cart-drawer.is-open {
  transform: translateX(0);
}

.cart-drawer-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-drawer-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  margin-bottom: 0;
}

.cart-drawer-items {
  flex-grow: 1;
  overflow-y: auto;
  padding: 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.cart-item {
  display: flex;
  gap: 1rem;
  padding-bottom: 1.1rem;
  border-bottom: 1px solid var(--border-light);
  position: relative;
}

.cart-item-img {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  background-color: var(--bg-surface-alt);
  flex-shrink: 0;
}

.cart-item-info {
  flex-grow: 1;
}

.cart-item-title {
  font-family: var(--font-serif);
  font-size: 0.98rem;
  font-weight: 600;
  margin-bottom: 0.2rem;
  line-height: 1.3;
}

.cart-item-meta {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-bottom: 0.45rem;
}

.cart-qty-ctrl {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-full);
  padding: 0.15rem 0.45rem;
  gap: 0.5rem;
}

.cart-qty-btn {
  background: none;
  border: none;
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-main);
  font-size: 0.85rem;
  cursor: pointer;
  border-radius: 50%;
}

.cart-qty-btn:hover {
  background-color: var(--bg-surface-alt);
}

.cart-qty-num {
  font-size: 0.85rem;
  font-weight: 600;
  min-width: 16px;
  text-align: center;
}

.cart-item-remove {
  background: none;
  border: none;
  color: var(--text-subtle);
  font-size: 0.9rem;
  cursor: pointer;
  padding: 0.2rem;
}

.cart-item-remove:hover {
  color: #C23838;
}

.cart-drawer-footer {
  padding: 1.25rem 1.5rem;
  border-top: 1px solid var(--border-light);
  background-color: var(--bg-surface-tint);
}

.cart-subtotal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;
  font-size: 0.95rem;
}

.cart-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.1rem;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-heading);
}

.free-shipping-progress {
  background: rgba(94, 140, 106, 0.15);
  border-radius: var(--radius-full);
  height: 6px;
  overflow: hidden;
  margin-bottom: 0.85rem;
}

.free-shipping-bar {
  background: var(--color-pistachio);
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.4s ease;
}

/* --------------------------------------------------------------------------
   13. FORMS & INPUT CONTROLS
   -------------------------------------------------------------------------- */
.form-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-heading);
  margin-bottom: 0.4rem;
}

.form-control, .form-select {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-medium);
  color: var(--text-main);
  border-radius: var(--radius-sm);
  padding: 0.72rem 1.1rem;
  font-size: 0.935rem;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-control:focus, .form-select:focus {
  background-color: var(--bg-surface);
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px rgba(94, 140, 106, 0.2);
  color: var(--text-main);
}

.form-control::placeholder {
  color: var(--text-subtle);
  opacity: 0.8;
}

.form-feedback {
  font-size: 0.8rem;
  margin-top: 0.35rem;
  display: none;
}

.is-invalid ~ .invalid-feedback,
.was-validated :invalid ~ .invalid-feedback {
  display: block;
  color: #D32F2F;
}

.is-valid ~ .valid-feedback {
  display: block;
  color: #2E7D32;
}

/* --------------------------------------------------------------------------
   14. FOOTER & COPYRIGHT
   -------------------------------------------------------------------------- */
.site-footer {
  background-color: var(--bg-footer);
  color: rgba(250, 247, 242, 0.8);
  padding-top: clamp(4rem, 6vw, 5.5rem);
  padding-bottom: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.site-footer .footer-brand {
  width: fit-content;
}

.site-footer h5, .site-footer .footer-title {
  color: #FAF7F2;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 1.35rem;
  letter-spacing: -0.01em;
}

.site-footer p {
  color: rgba(250, 247, 242, 0.72);
  font-size: 0.925rem;
  line-height: 1.65;
}

.footer-nav {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-nav li {
  margin-bottom: 0.65rem;
}

.footer-nav a {
  color: rgba(250, 247, 242, 0.75);
  font-size: 0.925rem;
  transition: all var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.footer-nav a:hover {
  color: var(--color-gold-light);
  transform: translateX(4px);
}

.footer-social-links {
  display: flex;
  gap: 0.65rem;
  margin-top: 1.25rem;
}

.social-icon-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #FAF7F2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  transition: all var(--transition-fast);
}

.social-icon-btn:hover {
  background: var(--color-gold);
  color: #12241D;
  border-color: var(--color-gold);
  transform: translateY(-3px);
}

.footer-newsletter-wrap {
  position: relative;
  margin-top: 1rem;
}

.footer-bottom {
  margin-top: 3.5rem;
  padding-top: 1.8rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.85rem;
  color: rgba(250, 247, 242, 0.6);
}

/* --------------------------------------------------------------------------
   15. ACCORDION (FAQ) & PRODUCT TABS
   -------------------------------------------------------------------------- */
.accordion-custom .accordion-item {
  background-color: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-md) !important;
  margin-bottom: 0.9rem;
  overflow: hidden;
  box-shadow: var(--shadow-xs);
}

.accordion-custom .accordion-button {
  background-color: var(--bg-card);
  color: var(--text-heading);
  font-family: var(--font-serif);
  font-size: 1.05rem;
  font-weight: 600;
  padding: 1.15rem 1.4rem;
  box-shadow: none;
}

.accordion-custom .accordion-button:not(.collapsed) {
  background-color: var(--bg-surface-tint);
  color: var(--color-primary);
}

[data-bs-theme="dark"] .accordion-custom .accordion-button:not(.collapsed) {
  color: var(--color-gold);
}

.accordion-custom .accordion-body {
  padding: 1.25rem 1.4rem;
  color: var(--text-muted);
  font-size: 0.935rem;
  line-height: 1.68;
}

/* Scroll To Top Button */
.scroll-top-btn {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #FFFFFF;
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  cursor: pointer;
  z-index: 1040;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.scroll-top-btn.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.scroll-top-btn:hover {
  background-color: var(--color-gold);
  color: #12241D;
  transform: translateY(-3px);
}
